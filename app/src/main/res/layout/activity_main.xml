<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0f172a"
    android:padding="16dp">

    <!-- Connection Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnAutoAP"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auto AP"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#8b5cf6" />

        <EditText
            android:id="@+id/etIpAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="192.168.4.1"
            android:textColor="#ffffff"
            android:textColorHint="#94a3b8"
            android:backgroundTint="#3b82f6"
            android:hint="ESP32 IP Address"
            android:inputType="textUri" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connect"
            android:layout_marginStart="8dp"
            android:backgroundTint="#10b981" />
    </LinearLayout>

    <!-- Camera Stream Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:background="#000000"
        android:layout_marginBottom="16dp">
        
        <WebView
            android:id="@+id/webViewCam"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Camera Stream"
            android:textColor="#88ffffff"
            android:layout_gravity="center"
            android:elevation="0dp"/>
    </FrameLayout>

    <!-- Robot Action Controls -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="3"
        android:alignmentMode="alignBounds"
        android:useDefaultMargins="true"
        android:layout_marginBottom="16dp">

        <Button android:id="@+id/btnSit" android:text="Sit" android:backgroundTint="#f59e0b" android:layout_columnWeight="1" />
        <Button android:id="@+id/btnForward" android:text="Forward" android:backgroundTint="#3b82f6" android:layout_columnWeight="1" />
        <Button android:id="@+id/btnStand" android:text="Stand" android:backgroundTint="#f59e0b" android:layout_columnWeight="1" />

        <Button android:id="@+id/btnLeft" android:text="Wave L" android:backgroundTint="#8b5cf6" android:layout_columnWeight="1" />
        <Button android:id="@+id/btnStop" android:text="STOP" android:backgroundTint="#ef4444" android:layout_columnWeight="1" />
        <Button android:id="@+id/btnRight" android:text="Wave R" android:backgroundTint="#8b5cf6" android:layout_columnWeight="1" />

        <Button android:id="@+id/btnCrawl" android:text="Crawl" android:backgroundTint="#14b8a6" android:layout_columnWeight="1" />
        <Button android:id="@+id/btnBackward" android:text="Backward" android:backgroundTint="#3b82f6" android:layout_columnWeight="1" />
        <Button android:id="@+id/btnLeap" android:text="Leap" android:backgroundTint="#14b8a6" android:layout_columnWeight="1" />
    </GridLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Push To Talk Walkie Talkie Button -->
    <Button
        android:id="@+id/btnPushToTalk"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:text="HOLD TO TALK\n(Walkie-Talkie)"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:backgroundTint="#475569" />

</LinearLayout>