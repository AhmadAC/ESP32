<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network and Wi-Fi Permissions (Required for Camera Stream, mDNS, and UDP broadcasts) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Location Permissions (Required for Wi-Fi SSID scanning and legacy Bluetooth scans) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Legacy Bluetooth Permissions (Required for Android 11 / API 30 and below) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!-- Modern Bluetooth Permissions (Required for Android 12 / API 31 and above) -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Audio Recording Permission (Required for Walkie-Talkie stream) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Notification Permission (Required for Android 13 / API 33 and above) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Declare BLE Feature Requirement -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="ESPRobot Controller"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        tools:targetApi="m">
        
        <activity
            android:name="com.example.mybasicapp.MainActivity"
            android:exported="true"
            android:label="ESPRobot Controller"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>